# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào git

# ── Server ──────────────────────────────
PORT=3001

# ── MySQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wedding_db
DB_USER=wedding_user
DB_PASSWORD=your_password_here

# ── CORS ────────────────────────────────
# URL của frontend (dùng khi deploy)
CLIENT_ORIGIN=http://localhost:5500

# ── Rate limiting ────────────────────────
# Số request tối đa mỗi 15 phút / mỗi IP
RATE_LIMIT_MAX=30
