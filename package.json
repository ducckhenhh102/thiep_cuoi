{
  "name": "wedding-invitation",
  "version": "1.0.0",
  "description": "Website thiệp cưới online — Minh & Lan",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/src/server.js",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npx serve client -p 5500 --no-clipboard",
    "dev": "npm run dev:server & npm run dev:client",
    "db:init": "node -e \"require('./server/src/config/database.js').initDB()\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "serve": "^14.2.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
